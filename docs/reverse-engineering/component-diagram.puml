@startuml
title TARS originale - Componenti principali
left to right direction
skinparam linetype ortho
skinparam componentStyle uml2
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #526477
skinparam NoteBackgroundColor #F5F7FA
skinparam NoteBorderColor #CCD5DF
skinparam componentBackgroundColor #EDF2F7
skinparam componentBorderColor #526477
skinparam classBackgroundColor #EDF2F7
skinparam classBorderColor #526477
skinparam participantBackgroundColor #EDF2F7
skinparam participantBorderColor #526477

component "VS Code" as cmpVS
component "Commands" as cmpCommands
component "Configurazione LLM" as cmpConfig
component "Theory of Mind" as cmpTom
component "RAG" as cmpRag
component "Agent / Planner" as cmpAgent
component "LLMFactory" as cmpFactory #F2F2F2
component "ChatOpenAI" as cmpChat

cmpVS --> cmpCommands
cmpCommands --> cmpConfig
cmpCommands --> cmpTom
cmpCommands --> cmpRag
cmpCommands --> cmpAgent
cmpAgent --> cmpChat
cmpAgent ..> cmpFactory
cmpFactory --> cmpChat

note bottom of cmpAgent
  planner() usa direttamente ChatOpenAI.
  critiqueNode() non e collegato al grafo.
end note
legend bottom
  Vista selettiva: otto componenti; dettagli interni omessi.
  Tratteggio: dipendenza presente solo nel codice scollegato.
endlegend
@enduml
