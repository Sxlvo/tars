@startuml
title TARS originale - Dipendenze LLM prima di CR1
left to right direction
skinparam linetype ortho
skinparam classAttributeIconSize 0
hide empty members
hide circle
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #526477
skinparam NoteBackgroundColor #F5F7FA
skinparam NoteBorderColor #CCD5DF
skinparam componentBackgroundColor #EDF2F7
skinparam componentBorderColor #526477
skinparam classBackgroundColor #EDF2F7
skinparam classBorderColor #526477
skinparam participantBackgroundColor #EDF2F7
skinparam participantBorderColor #526477

class "configureTarsCommand.js" as clsConfig <<module>> {
  configureTars(context)
}
class "explainCodeCommand" as clsExplain <<function>> {
  (context)
}
class "agentState" as clsState <<Annotation.Root>> {
  modelName
  llmType
  llmAPI
}
class "planner" as clsPlanner <<function>> {
  (state)
}
class "critiqueNode" as clsCritique <<function>> #F2F2F2 {
  (state)
}
class "LLMFactory" as clsFactory <<object literal>> {
  createLLM(llmType, modelName, apiKey)
}
class "ChatOpenAI" as clsChat <<library>> {
  withStructuredOutput(schema, options)
}

clsExplain ..> clsConfig
clsExplain ..> clsState
clsPlanner ..> clsState
clsPlanner ..> clsChat
clsCritique ..> clsFactory
clsFactory ..> clsChat

note bottom of clsConfig
  globalState: tarsConfiguration
  {llmName, llmType: "openai", apiKey}
end note
note bottom of clsCritique
  Funzione definita ma nodo non registrato.
end note
legend bottom
  I riquadri <<function>>, <<module>> e <<object literal>>
  NON rappresentano classi JavaScript.
  agentState mostra solo i campi LLM essenziali.
endlegend
@enduml
